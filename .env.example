# Příklad konfigurace proměnných prostředí pro Neon databázi
# Zkopírujte tento soubor jako .env (který je v .gitignore) nebo nastavte proměnné v IDE

# Údaje z Neon Console (Dashboard -> Connection Details)
NEON_HOST=ep-example-123456.eu-central-1.aws.neon.tech
NEON_DB=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=your_neon_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Externí API
OSRM_BASE_URL=http://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
